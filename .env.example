# Copy to .env (setup.sh does this for you and fills in the passwords).
COMPOSE_PROJECT_NAME=impeccabyte
WEB_PORT=8080
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
SITE_NAME=Impeccabyte
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-three
