<section{{ attributes.addClass(['section', 'case-study']) }} aria-labelledby="{{ id }}-title">
  <div class="section__inner case-study__inner">
    <div class="case-study__media">
      {% if media.url %}
        <img src="{{ media.url }}" alt="{{ media.alt }}" loading="lazy">
      {% else %}
        <div class="case-study__placeholder" role="img" aria-label="{{ 'Photo placeholder'|t }}"><span>{{ 'Photo to come'|t }}</span></div>
      {% endif %}
    </div>
    <div class="case-study__text">
      {% if placeholder %}{{ include('impeccabyte:badge', {label: 'Example story. A real customer story goes here.'|t, variant: 'warning'}, with_context = false) }}{% endif %}
      {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
      <h2 class="section-header__heading" id="{{ id }}-title">{{ heading }}</h2>
      {% if body %}<p class="lead">{{ body }}</p>{% endif %}
      {% if items %}
        <dl class="case-study__metrics">
          {% for metric in items %}<div><dt>{{ metric.label }}</dt><dd>{{ metric.value }}</dd></div>{% endfor %}
        </dl>
      {% endif %}
      {% if link.url %}<a class="text-link" href="{{ link.url }}">{{ link.title }} {{ include('impeccabyte:icon', {name: 'arrow-right', size: 16}, with_context = false) }}</a>{% endif %}
    </div>
  </div>
</section>
