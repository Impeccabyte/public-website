<section{{ attributes.addClass(['section', 'section--flush-top', 'pricing-cards']) }} aria-labelledby="{{ id }}-title">
  <div class="section__inner pricing-cards__inner">
    <h2 class="visually-hidden" id="{{ id }}-title">{{ heading|default('Pricing programs'|t) }}</h2>
    <div class="grid-auto pricing-cards__grid">
      {% for card in items %}
        {{ include('impeccabyte:pricing-card', card|merge({show_prices: show_prices, price_placeholder: price_placeholder, quote_url: quote_url}), with_context = false) }}
      {% endfor %}
    </div>
    {% set note = (show_prices and price_note) ? price_note : footnote %}
    {% if note %}<p class="pricing-cards__note">{{ note }}</p>{% endif %}
  </div>
</section>
