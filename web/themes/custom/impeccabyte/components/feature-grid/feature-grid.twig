<section{{ attributes.addClass(['section', 'feature-grid', items|length == 4 ? 'feature-grid--four', items|length == 3 ? 'feature-grid--three', items|length > 4 and items|filter(c => c.body)|length == 0 ? 'feature-grid--links']) }} id="{{ anchor|default(id) }}"{% if heading %} aria-labelledby="{{ id }}-title"{% endif %}>
  <div class="section__inner">
    {{ include('impeccabyte:section-header', {eyebrow: eyebrow, heading: heading, intro: intro, heading_id: id ~ '-title'}, with_context = false) }}
    <div class="grid-auto feature-grid__grid">
      {% for card in items %}{{ include('impeccabyte:feature-card', card, with_context = false) }}{% endfor %}
    </div>
  </div>
</section>
