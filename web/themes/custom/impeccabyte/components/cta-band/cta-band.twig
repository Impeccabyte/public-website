<section{{ attributes.addClass(['section', 'section--flush-top', 'cta-band']) }} aria-labelledby="{{ id }}-title">
  <div class="cta-band__box">
    <div class="cta-band__text">
      <h2 class="cta-band__title" id="{{ id }}-title">
        {%- if accent_word and accent_word in heading -%}
          {%- set parts = heading|split(accent_word, 2) -%}
          {{ parts[0] }}<em class="cta-band__accent">{{ accent_word }}</em>{{ parts[1] }}
        {%- else -%}{{ heading }}{%- endif -%}
      </h2>
      {% if body %}<p class="cta-band__body">{{ body }}</p>{% endif %}
    </div>
    <div class="cta-band__actions">
      {% if link.url %}{{ include('impeccabyte:button', {label: link.title, href: link.url, variant: 'primary', size: 'lg'}, with_context = false) }}{% endif %}
      {% if link_secondary.url %}{{ include('impeccabyte:button', {label: link_secondary.title, href: link_secondary.url, variant: 'on-dark', size: 'lg'}, with_context = false) }}{% endif %}
    </div>
  </div>
</section>
