{% set featured_markup = featured|render %}
<header{{ attributes.addClass('site-header') }} role="banner" data-site-header>
  <div class="site-header__bar">
    <a class="site-header__logo" href="{{ home_url }}" aria-label="{{ 'Impeccabyte home'|t }}">{{ include('impeccabyte:logo', {id: 'logo-rise-header'}, with_context = false) }}</a>
    <nav class="site-header__nav" aria-label="{{ 'Main'|t }}">
      <ul class="site-header__list">
        {% for item in items %}
          <li>
            {% if item.children %}
              <button class="site-header__navbtn{{ item.active ? ' is-on' }}" type="button" aria-expanded="false" aria-controls="mega-{{ loop.index }}" data-mega-toggle>{{ item.title }} {{ include('impeccabyte:icon', {name: 'chevron-down', size: 16}, with_context = false) }}</button>
            {% else %}
              <a class="site-header__navbtn{{ item.active ? ' is-on' }}" href="{{ item.url }}"{{ item.current ? ' aria-current="page"' }}>{{ item.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="site-header__login" href="{{ login_url }}">{{ 'Log in'|t }}</a>
      <span class="site-header__cta">{{ include('impeccabyte:button', {label: 'Get a quote'|t, href: quote_url, variant: 'primary'}, with_context = false) }}</span>
      <button class="site-header__burger" type="button" aria-expanded="false" aria-controls="site-drawer" data-drawer-toggle>
        <span class="visually-hidden" data-drawer-label data-open-label="{{ 'Open menu'|t }}" data-close-label="{{ 'Close menu'|t }}">{{ 'Open menu'|t }}</span>
        <span class="site-header__burger-open">{{ include('impeccabyte:icon', {name: 'menu', size: 20}, with_context = false) }}</span>
        <span class="site-header__burger-close">{{ include('impeccabyte:icon', {name: 'x', size: 20}, with_context = false) }}</span>
      </button>
    </div>
  </div>
  {% for item in items %}
    {% if item.children %}
      {{ include('impeccabyte:mega-menu', {id: 'mega-' ~ loop.index, label: item.title, items: item.children, quote_url: quote_url, phone: phone, hours: hours, featured: featured_markup}, with_context = false) }}
    {% endif %}
  {% endfor %}
  {{ include('impeccabyte:mobile-drawer', {id: 'site-drawer', items: items, quote_url: quote_url, login_url: login_url, phone: phone}, with_context = false) }}
</header>
