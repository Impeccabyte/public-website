<section{{ attributes.addClass(['section', 'section--brand', 'testimonial']) }} aria-label="{{ placeholder ? 'Example customer story'|t : 'Customer story'|t }}">
  <div class="section__inner testimonial__inner">
    <figure class="testimonial__figure">
      {% if placeholder %}{{ include('impeccabyte:badge', {label: 'Example quote. A real customer story goes here.'|t, variant: 'warning'}, with_context = false) }}{% endif %}
      <span class="testimonial__mark">{{ include('impeccabyte:icon', {name: 'quote', size: 44}, with_context = false) }}</span>
      <blockquote class="testimonial__quote">“{{ quote }}”</blockquote>
      <figcaption class="testimonial__caption">
        <span class="testimonial__avatar">{{ include('impeccabyte:icon', {name: 'user', size: 24}, with_context = false) }}</span>
        <span><span class="testimonial__name">{{ name }}</span><span class="testimonial__role">{{ role }}</span></span>
      </figcaption>
    </figure>
    {% if before or after %}
      <div class="testimonial__figures card card--pad-sm card--raised">
        {% if label %}<p class="testimonial__figures-label">{{ label }}</p>{% endif %}
        <dl>
          {% if before %}<div><dt>{{ 'Before'|t }}</dt><dd class="testimonial__before"><s>{{ before }}</s></dd></div>{% endif %}
          {% if after %}<div><dt>{{ 'After'|t }}</dt><dd class="testimonial__after">{{ after }}</dd></div>{% endif %}
        </dl>
        {% if link.url %}<a class="text-link" href="{{ link.url }}">{{ link.title }} {{ include('impeccabyte:icon', {name: 'arrow-right', size: 16}, with_context = false) }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
</section>
