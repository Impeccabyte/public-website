{#
  An example document with its confusing lines numbered and explained in
  plain English. By default it is a processing statement from another
  processor; confirmation-art passes a hotel confirmation instead. The
  figures are invented to show how the document reads; they are not
  Impeccabyte's prices. The document is decorative; the explanations are
  real text.

  rows: {label, value, num (numbered and highlighted), kind: 'meta' (muted),
  'rule' (dashed line) or 'total'}. notes: {title, text}, one per num.
#}
{% set default_rows = [
  {kind: 'rule'},
  {label: 'Card sales'|t, value: '$18,420.00'},
  {label: 'Interchange and assessments'|t, value: '$412.36', num: 1},
  {label: 'Discount rate 0.25%'|t, value: '$46.05'},
  {label: 'Non-qualified surcharge'|t, value: '$86.20', num: 2},
  {label: 'Statement fee'|t, value: '$9.95'},
  {label: 'PCI non-compliance'|t, value: '$39.95', num: 3},
  {kind: 'rule'},
  {label: 'Total fees'|t, value: '$594.51', kind: 'total'},
] %}
{% set default_notes = [
  {title: 'Interchange and assessments'|t, text: "The card networks' own charge on each sale. Every processor pays it."|t},
  {title: 'Non-qualified surcharge'|t, text: "An extra charge when a card didn't fit your quoted rate. Worth asking about."|t},
  {title: 'PCI non-compliance'|t, text: 'Charged until your yearly security form is filed.'|t},
] %}
<figure{{ attributes.addClass('statement-art') }}>
  <div class="statement-art__sheet" aria-hidden="true">
    <div class="statement-art__head">
      <div class="statement-art__title">{{ title|default('Monthly processing statement'|t) }}</div>
      {{ include('impeccabyte:badge', {label: 'Example'|t, size: 'sm'}, with_context = false) }}
    </div>
    {% for row in rows|default(default_rows) %}
      {% if row.kind == 'rule' %}
        <div class="statement-art__rule"></div>
      {% else %}
        <div class="statement-art__line{{ row.num ? ' statement-art__line--flag' }}{{ row.kind == 'total' ? ' statement-art__line--total' }}{{ row.kind == 'meta' ? ' statement-art__line--meta' }}"><span>{% if row.num %}<b class="statement-art__num">{{ row.num }}</b>{% endif %}{{ row.label }}</span><span>{{ row.value }}</span></div>
      {% endif %}
    {% endfor %}
  </div>
  <figcaption class="statement-art__notes">
    <p class="statement-art__eyebrow">{{ 'In plain English'|t }}</p>
    <ol class="statement-art__list">
      {% for note in notes|default(default_notes) %}
        <li><span class="statement-art__num" aria-hidden="true">{{ loop.index }}</span><span><strong>{{ note.title }}</strong> {{ note.text }}</span></li>
      {% endfor %}
    </ol>
  </figcaption>
</figure>
