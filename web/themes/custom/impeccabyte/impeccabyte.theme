<?php

/**
 * @file
 * Theme hooks for Impeccabyte.
 */

use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Url;
use Drupal\menu_link_content\Plugin\Menu\MenuLinkContent;

/**
 * Implements hook_page_attachments_alter().
 */
function impeccabyte_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['library'][] = 'impeccabyte/fonts';
}

/**
 * Builds a plain array from a menu: title, url, description, icon, children.
 *
 * The description is the menu link's own description; the icon is the Lucide
 * name in its Icon field.
 */
function _impeccabyte_menu(string $menu_name, int $depth = 3): array {
  $menu_tree = \Drupal::menuTree();
  $parameters = (new MenuTreeParameters())
    ->setMaxDepth($depth)
    ->onlyEnabledLinks()
    ->setActiveTrail(\Drupal::service('menu.active_trail')->getActiveTrailIds($menu_name));
  $tree = $menu_tree->transform($menu_tree->load($menu_name, $parameters), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);
  $current = Url::fromRoute('<current>')->toString();
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');

  $build = function (array $elements) use (&$build, $current, $storage): array {
    $items = [];
    foreach ($elements as $element) {
      if ($element->access !== NULL && !$element->access->isAllowed()) {
        continue;
      }
      $link = $element->link;
      $url_object = $link->getUrlObject();
      $url = $url_object->isRouted() && in_array($url_object->getRouteName(), ['<nolink>', '<button>', '<none>'], TRUE) ? '' : $url_object->toString();
      $icon = '';
      if ($link instanceof MenuLinkContent) {
        $entities = $storage->loadByProperties(['uuid' => $link->getDerivativeId()]);
        if (($entity = reset($entities)) && $entity->hasField('field_icon')) {
          $icon = (string) $entity->get('field_icon')->value;
        }
      }
      $items[] = [
        'title' => $link->getTitle(),
        'url' => $url,
        'description' => (string) $link->getDescription(),
        'icon' => $icon,
        'active' => $element->inActiveTrail,
        'current' => $url !== '' && $url === $current,
        'children' => $element->subtree ? $build($element->subtree) : [],
      ];
    }
    return $items;
  };
  return $build($tree);
}

/**
 * Implements hook_preprocess_page().
 */
function impeccabyte_preprocess_page(array &$variables) {
  $settings = \Drupal::config('impeccabyte_site.settings');
  $quote_path = $settings->get('quote_path') ?: '/get-a-quote';
  $variables['front_url'] = Url::fromRoute('<front>')->toString();
  $variables['site'] = [
    'quote_url' => Url::fromUserInput($quote_path)->toString(),
    'login_url' => $settings->get('login_url'),
    'phone' => $settings->get('phone'),
    'hours' => $settings->get('hours'),
    'email' => $settings->get('email'),
    'address_line1' => $settings->get('address_line1'),
    'address_line2' => $settings->get('address_line2'),
    'disclosure' => $settings->get('disclosure'),
  ];

  $variables['main_menu'] = _impeccabyte_menu('main');
  $variables['footer_menus'] = [];
  $cache_tags = ['config:impeccabyte_site.settings', 'config:system.menu.main'];
  $menus = \Drupal::entityTypeManager()->getStorage('menu');
  foreach (['footer-solutions', 'footer-hardware', 'footer-industries', 'footer-company'] as $name) {
    if ($menu = $menus->load($name)) {
      $variables['footer_menus'][] = ['title' => $menu->label(), 'items' => _impeccabyte_menu($name, 1)];
      $cache_tags[] = 'config:system.menu.' . $name;
    }
  }
  $variables['legal_menu'] = $menus->load('footer-legal') ? _impeccabyte_menu('footer-legal', 1) : [];
  $cache_tags[] = 'config:system.menu.footer-legal';

  $variables['newsletter'] = NULL;
  if (\Drupal::moduleHandler()->moduleExists('webform') && \Drupal::entityTypeManager()->getStorage('webform')->load('newsletter')) {
    $variables['newsletter'] = ['#type' => 'webform', '#webform' => 'newsletter'];
  }

  // The header marks the current section, so the chrome varies by path.
  $variables['chrome_cache'] = ['#cache' => ['tags' => $cache_tags, 'contexts' => ['url.path']]];

  // Pages built here bring their own h1 in a hero. Everything else (log in,
  // error pages, admin-facing lists) gets a plain title above its content.
  $route = \Drupal::routeMatch();
  $own_title = FALSE;
  if (($node = $route->getParameter('node')) && $route->getRouteName() === 'entity.node.canonical') {
    $own_title = TRUE;
  }
  if (str_starts_with((string) $route->getRouteName(), 'view.') || in_array($route->getRouteName(), ['impeccabyte_compare.page'], TRUE)) {
    $own_title = TRUE;
  }
  if ($route->getRouteName() === 'entity.webform.canonical' && ($webform = $route->getParameter('webform')) && in_array($webform->id(), ['get_a_quote', 'specialty_prequal', 'statement_review'], TRUE)) {
    $own_title = TRUE;
  }
  $variables['fallback_title'] = NULL;
  if (!$own_title) {
    $title = \Drupal::service('title_resolver')->getTitle(\Drupal::request(), $route->getRouteObject());
    $variables['fallback_title'] = is_array($title) ? \Drupal::service('renderer')->renderInIsolation($title) : $title;
  }
}

/**
 * Implements hook_theme_suggestions_block_alter().
 *
 * Custom blocks get a template named after their type.
 */
function impeccabyte_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  $content = $variables['elements']['content'] ?? [];
  if (isset($content['#block_content'])) {
    $suggestions[] = 'block__' . $content['#block_content']->bundle();
  }
}

/**
 * Implements hook_preprocess_input().
 *
 * Submit buttons take the button component's classes unless a form set its own.
 */
function impeccabyte_preprocess_input(array &$variables) {
  $type = $variables['attributes']['type'] ?? '';
  if (in_array($type, ['submit', 'button'], TRUE)) {
    $classes = $variables['attributes']['class'] ?? [];
    $variants = ['button--secondary', 'button--ghost', 'button--accent', 'button--danger', 'button--on-dark'];
    if (array_intersect($variants, $classes)) {
      // Webform adds the primary class to every submit button.
      $classes = array_diff($classes, ['button--primary']);
    }
    elseif (in_array('webform-button--previous', $classes, TRUE)) {
      $classes = array_diff($classes, ['button--primary']);
      $classes[] = 'button--secondary';
    }
    elseif (!in_array('button--primary', $classes, TRUE)) {
      $classes[] = 'button--primary';
    }
    if (!in_array('button', $classes, TRUE)) {
      $classes[] = 'button';
    }
    $variables['attributes']['class'] = array_values($classes);
  }
}

/**
 * Turns an entity's fields into a plain array for components.
 *
 * Keys are field names without "field_". Single-value fields give one value,
 * multi-value fields a list. Paragraph references are followed.
 */
function _impeccabyte_entity_data($entity): array {
  $data = [];
  foreach ($entity->getFieldDefinitions() as $name => $definition) {
    if (!str_starts_with($name, 'field_')) {
      continue;
    }
    $values = [];
    $items = $entity->get($name);
    switch ($definition->getType()) {
      case 'text_long':
      case 'text_with_summary':
        foreach ($items as $item) {
          $values[] = ['#type' => 'processed_text', '#text' => $item->value, '#format' => $item->format ?: 'basic_html'];
        }
        break;

      case 'boolean':
        foreach ($items as $item) {
          $values[] = (bool) $item->value;
        }
        break;

      case 'link':
        foreach ($items as $item) {
          try {
            $values[] = ['url' => $item->getUrl()->toString(), 'title' => (string) $item->title];
          }
          catch (\Exception $e) {
            // A link that no longer resolves is left out.
          }
        }
        break;

      case 'entity_reference_revisions':
        foreach ($items->referencedEntities() as $child) {
          $values[] = ['bundle' => $child->bundle(), 'entity_id' => $child->id()] + _impeccabyte_entity_data($child);
        }
        break;

      case 'entity_reference':
        foreach ($items->referencedEntities() as $target) {
          $values[] = _impeccabyte_reference_data($target);
        }
        $values = array_values(array_filter($values));
        break;

      case 'webform':
        foreach ($items as $item) {
          $values[] = $item->target_id;
        }
        break;

      default:
        foreach ($items as $item) {
          $values[] = $item->value;
        }
    }
    $key = substr($name, 6);
    $data[$key] = $definition->getFieldStorageDefinition()->getCardinality() === 1 ? ($values[0] ?? NULL) : $values;
  }
  return $data;
}

/**
 * Describes a referenced term, node or media item for a component.
 */
function _impeccabyte_reference_data($target): ?array {
  switch ($target->getEntityTypeId()) {
    case 'taxonomy_term':
      return ['id' => (int) $target->id(), 'label' => $target->label()];

    case 'node':
      if (!$target->access('view')) {
        return NULL;
      }
      return ['id' => (int) $target->id(), 'label' => $target->label(), 'bundle' => $target->bundle(), 'url' => $target->toUrl()->toString(), 'entity' => $target];

    case 'media':
      if (!$target->access('view')) {
        return NULL;
      }
      $source = $target->getSource();
      $file_id = $source->getSourceFieldValue($target);
      $file = $file_id ? \Drupal::entityTypeManager()->getStorage('file')->load($file_id) : NULL;
      if (!$file) {
        return NULL;
      }
      $field = $source->getConfiguration()['source_field'];
      $item = $target->get($field)->first();
      return [
        'id' => (int) $target->id(),
        'label' => $target->label(),
        'bundle' => $target->bundle(),
        'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
        'alt' => $item && isset($item->alt) ? (string) $item->alt : '',
        'width' => $item->width ?? NULL,
        'height' => $item->height ?? NULL,
        'size' => $file->getSize(),
        'mime' => $file->getMimeType(),
      ];
  }
  return NULL;
}

/**
 * What every price-aware component needs to know.
 */
function _impeccabyte_price_context(): array {
  $prices = \Drupal::service('impeccabyte_site.prices');
  return [
    'show_prices' => $prices->shown(),
    'price_placeholder' => $prices->placeholder(),
    'quote_url' => Url::fromUserInput($prices->quotePath())->toString(),
  ];
}

/**
 * Renders device or resource cards for a list of nodes.
 */
function _impeccabyte_teasers(array $nodes): array {
  $builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $build = [];
  foreach ($nodes as $node) {
    if ($node->access('view')) {
      $build[] = $builder->view($node, 'teaser');
    }
  }
  return $build;
}

/**
 * Implements hook_preprocess_paragraph().
 *
 * Each section paragraph is handed to the component named after its type.
 */
function impeccabyte_preprocess_paragraph(array &$variables) {
  /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
  $paragraph = $variables['paragraph'];
  $bundle = $paragraph->bundle();
  $data = _impeccabyte_entity_data($paragraph) + _impeccabyte_price_context();
  $data['id'] = 'section-' . $paragraph->id();
  $components = ['callout' => 'callout-band'];
  $variables['component'] = 'impeccabyte:' . ($components[$bundle] ?? str_replace('_', '-', $bundle));

  switch ($bundle) {
    case 'hero':
      $data['breadcrumb'] = [];
      if (!empty($data['show_breadcrumb'])) {
        $data['breadcrumb'] = _impeccabyte_breadcrumb();
      }
      break;

    case 'card_grid':
      $data['cards'] = [];
      if ($data['source'] === 'manual') {
        $data['cards'] = _impeccabyte_teasers(array_column($data['devices'], 'entity'));
      }
      elseif (\Drupal::entityTypeManager()->getStorage('view')->load('devices_by_filter')) {
        $data['cards'] = ['#type' => 'view', '#name' => 'devices_by_filter', '#display_id' => $data['source']];
      }
      unset($data['devices']);
      break;

    case 'related_resources':
      $data['cards'] = _impeccabyte_teasers(array_column($data['resources'], 'entity'));
      unset($data['resources']);
      break;

    case 'webform_embed':
      $data['form'] = $data['webform'] ? ['#type' => 'webform', '#webform' => $data['webform']] : NULL;
      break;

    case 'bundle':
      $total = 0.0;
      $complete = TRUE;
      foreach ($data['items'] as &$item) {
        $node = $item['reference']['entity'] ?? NULL;
        $item['name'] = $item['title'] ?: ($item['reference']['label'] ?? '');
        $item['url'] = $item['reference']['url'] ?? '';
        $item['quantity'] = max(1, (int) ($item['quantity'] ?: 1));
        $each = $item['monthly_price'];
        if ($each === NULL && $node && $node->hasField('field_lease_price') && !$node->get('field_lease_price')->isEmpty()) {
          $each = $node->get('field_lease_price')->value;
        }
        $item['each'] = $each;
        $item['line_total'] = $each !== NULL ? (float) $each * $item['quantity'] : NULL;
        if ($item['line_total'] === NULL) {
          $complete = FALSE;
        }
        else {
          $total += $item['line_total'];
        }
        unset($item['reference']);
      }
      unset($item);
      $data['total'] = $total;
      $data['total_complete'] = $complete;
      break;

    case 'faq':
      // FAQPage structured data, built from the same questions.
      $entities = [];
      foreach ($paragraph->get('field_items')->referencedEntities() as $item) {
        $entities[] = [
          '@type' => 'Question',
          'name' => $item->get('field_question')->value,
          'acceptedAnswer' => ['@type' => 'Answer', 'text' => trim(strip_tags((string) $item->get('field_answer')->value, '<a><p><br><ul><ol><li><strong><em>'))],
        ];
      }
      if ($entities) {
        $variables['#attached']['html_head'][] = [[
          '#tag' => 'script',
          '#attributes' => ['type' => 'application/ld+json'],
          '#value' => json_encode(['@context' => 'https://schema.org', '@type' => 'FAQPage', 'mainEntity' => $entities], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
        ], 'impeccabyte_faq_' . $paragraph->id()];
      }
      break;
  }
  $variables['data'] = $data;
}

/**
 * The trail to the current page: Home, its section and the page itself.
 */
function _impeccabyte_breadcrumb(): array {
  $trail = [['title' => t('Home'), 'url' => Url::fromRoute('<front>')->toString()]];
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    $sections = [
      'solution' => [t('Solutions'), NULL],
      'industry_page' => [t('Industries'), NULL],
      'device' => [t('Hardware'), '/hardware'],
      'resource' => [t('Resources'), '/resources'],
    ];
    if (isset($sections[$node->bundle()])) {
      [$title, $path] = $sections[$node->bundle()];
      $trail[] = ['title' => $title, 'url' => $path ? Url::fromUserInput($path)->toString() : ''];
    }
    $trail[] = ['title' => $node->label(), 'url' => ''];
  }
  return $trail;
}

/**
 * Implements hook_preprocess_node().
 */
function impeccabyte_preprocess_node(array &$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if ($node->bundle() === 'device') {
    $variables['device'] = _impeccabyte_device_data($node, $variables['view_mode'] === 'full');
  }
}

/**
 * Everything the device card and device page components need.
 */
function _impeccabyte_device_data($node, bool $full): array {
  $prices = \Drupal::service('impeccabyte_site.prices');
  $type = $node->get('field_device_type')->entity;
  $make = $node->get('field_manufacturer')->entity;
  $shapes = ['Handheld' => 'tall', 'Mobile reader' => 'reader', 'Countertop terminal' => 'square', 'Self-order kiosk' => 'tall'];
  $gallery = [];
  foreach ($node->get('field_gallery')->referencedEntities() as $media) {
    if ($image = _impeccabyte_reference_data($media)) {
      $gallery[] = $image;
    }
  }
  $data = [
    'nid' => (int) $node->id(),
    'title' => $node->label(),
    'url' => $node->toUrl()->toString(),
    'manufacturer' => $make ? $make->label() : '',
    'type' => $type ? $type->label() : '',
    'summary' => $node->get('field_card_summary')->value,
    'lease' => $prices->format($node->get('field_lease_price')->value),
    'buy' => $prices->format($node->get('field_buy_price')->value),
    'image' => $gallery[0] ?? NULL,
    'shape' => $shapes[$type ? $type->label() : ''] ?? 'wide',
  ] + _impeccabyte_price_context();
  if (!$full) {
    return $data;
  }

  $fields = _impeccabyte_entity_data($node);
  foreach ($fields['fees'] as &$fee) {
    $fee['amount'] = $prices->format($fee['amount']);
  }
  unset($fee);
  $catalog = Url::fromUserInput('/hardware');
  $breadcrumb = [['title' => t('Hardware'), 'url' => $catalog->toString()]];
  if ($type) {
    $breadcrumb[] = ['title' => $type->label(), 'url' => Url::fromUserInput('/hardware', ['query' => ['type' => [$type->id() => $type->id()]]])->toString()];
  }
  $breadcrumb[] = ['title' => $node->label(), 'url' => ''];

  return [
    'manufacturer' => ['label' => $data['manufacturer']],
    'device_type' => ['label' => $data['type']],
    'summary' => $fields['summary'],
    'gallery' => $gallery,
    'breadcrumb' => $breadcrumb,
    'in_stock' => $fields['in_stock'],
    'dual_pricing_ready' => $fields['dual_pricing_ready'],
    'lease_terms' => $fields['lease_terms'],
    'buy_terms' => $fields['buy_terms'],
    'fees' => $fields['fees'],
    'key_features' => $fields['key_features'],
    'specs' => $fields['specs'],
    'gateways' => $fields['gateways'],
    'gateway_note' => $fields['gateway_note'],
    'documents' => $fields['documents'],
    'related' => _impeccabyte_teasers(array_column($fields['related_devices'], 'entity')),
  ] + $data;
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * The hardware catalog's facets move into the filter rail, with "Clear all"
 * in its head. The sort select stays outside so it can sit above the results.
 */
function impeccabyte_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (($form['#id'] ?? '') !== 'views-exposed-form-hardware-catalog-page-1') {
    return;
  }
  $form['#attributes']['class'][] = 'catalog-form';
  // "Clear all" is a plain link back to the unfiltered catalog. The form's
  // own buttons stay where Views put them: moving them makes Views read a
  // plain page load as a reset and redirect forever.
  $rail = [
    '#type' => 'container',
    '#attributes' => ['class' => ['catalog-rail'], 'id' => 'catalog-filters', 'role' => 'group', 'aria-label' => t('Filters')],
    '#weight' => -10,
    'head' => [
      '#type' => 'inline_template',
      '#template' => '<div class="catalog-rail__head"><h2 class="catalog-rail__title">{{ title }}</h2><a class="catalog-rail__reset" href="{{ url }}">{{ reset }}</a></div>',
      '#context' => ['title' => t('Filters'), 'reset' => t('Clear all'), 'url' => Url::fromUserInput('/hardware')->toString()],
    ],
  ];
  foreach (['type', 'channel', 'industry', 'make'] as $key) {
    if (isset($form[$key])) {
      $rail[$key] = $form[$key];
      unset($form[$key]);
    }
  }
  $form['rail'] = $rail;
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'button--secondary';
  }
  $form['actions']['#attributes']['class'][] = 'catalog-form__actions';
}

/**
 * Implements hook_preprocess_views_view().
 */
function impeccabyte_preprocess_views_view(array &$variables) {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];
  if ($view->id() === 'hardware_catalog') {
    $variables['total'] = count($view->result);
    $input = $view->getExposedInput();
    $labels = [];
    $active = 0;
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    foreach (['type', 'channel', 'industry', 'make'] as $key) {
      $ids = array_filter((array) ($input[$key] ?? []));
      $active += count($ids);
      if ($key === 'type' && $ids) {
        foreach ($terms->loadMultiple($ids) as $term) {
          $labels[] = $term->label();
        }
      }
    }
    $variables['active_count'] = $active;
    $variables['summary'] = $labels ? implode(', ', $labels) : ($active ? t('Filtered') : t('All types'));
  }
}
