<?php

/**
 * @file
 * Site-wide behavior for the Impeccabyte marketing site.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_build_defaults_alter().
 *
 * Anything that can show a price is rebuilt when "Show prices" changes.
 */
function impeccabyte_site_entity_build_defaults_alter(array &$build, EntityInterface $entity, $view_mode) {
  if (in_array($entity->getEntityTypeId(), ['node', 'paragraph'], TRUE)) {
    $build['#cache']['tags'][] = 'config:impeccabyte_site.settings';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Sorting by price would order devices by numbers that are not public yet,
 * so those sort options are left out while "Show prices" is off.
 */
function impeccabyte_site_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $form['#cache']['tags'][] = 'config:impeccabyte_site.settings';
  if (\Drupal::service('impeccabyte_site.prices')->shown()) {
    return;
  }
  foreach (['sort_bef_combine', 'sort_by'] as $key) {
    if (isset($form[$key]['#options'])) {
      foreach (array_keys($form[$key]['#options']) as $option) {
        if (str_contains((string) $option, 'price')) {
          unset($form[$key]['#options'][$option]);
        }
      }
    }
  }
}

/**
 * Implements hook_metatags_alter().
 *
 * A page's "Search title" field, when set, becomes the browser-tab title
 * (scripts/setup/88-search-title.php). A webform page (such as /get-a-quote)
 * has no node to carry a search description, so it comes from the form's own
 * "impeccabyte_site" setting.
 */
function impeccabyte_site_metatags_alter(array &$metatags, array &$context) {
  $entity = $context['entity'] ?? NULL;
  if ($entity instanceof \Drupal\node\NodeInterface && $entity->hasField('field_search_title') && ($title = trim((string) $entity->get('field_search_title')->value)) !== '') {
    $metatags['title'] = $title;
  }
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.webform.canonical') {
    return;
  }
  $webform = \Drupal::routeMatch()->getParameter('webform');
  if ($webform instanceof \Drupal\webform\WebformInterface && ($description = $webform->getThirdPartySetting('impeccabyte_site', 'meta_description'))) {
    $metatags['description'] = $description;
    $metatags['og_description'] = $description;
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Describes the business to search engines on the home page, as JSON-LD:
 * a FinancialService (a LocalBusiness subtype) with its service area.
 *
 * There is deliberately no street address. Specialists work mobile and meet
 * merchants by appointment, and the only address is a mail-only mailbox,
 * which is not where the business operates. Google's LocalBusiness rich
 * result needs a street address, so this markup earns no rich result; it
 * states who the business is and where it serves, matching the Google
 * Business Profile's service area (2026-11-23).
 */
function impeccabyte_site_page_attachments(array &$attachments) {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }
  $config = \Drupal::config('impeccabyte_site.settings');
  $base = \Drupal::request()->getSchemeAndHttpHost();
  $texas = ['@type' => 'State', 'name' => 'Texas'];
  $data = [
    '@context' => 'https://schema.org',
    '@type' => 'FinancialService',
    '@id' => $base . '/#business',
    'name' => \Drupal::config('system.site')->get('name'),
    'url' => $base . '/',
    'logo' => $base . '/themes/custom/impeccabyte/apple-touch-icon.png',
    'image' => $base . '/themes/custom/impeccabyte/apple-touch-icon.png',
    'email' => $config->get('email'),
    'description' => 'Merchant services agency in Austin, Texas: card processing, POS hardware and payment software, set up and supported by local specialists who meet merchants by appointment, in person or on Microsoft Teams. Authorized sales agent of Maverick Payments.',
    'areaServed' => array_map(fn(string $city) => ['@type' => 'City', 'name' => $city, 'containedInPlace' => $texas], $config->get('service_area') ?? []),
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode(array_filter($data), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ],
    'impeccabyte_site_business_jsonld',
  ];
  $attachments['#cache']['tags'][] = 'config:impeccabyte_site.settings';
  $attachments['#cache']['tags'][] = 'config:system.site';
}
